    "steps": [
      {
        "title": {
          "en": "Consultation",
          "ar": "الاستشارة"
        },
        "text": {
          "en": "We discuss occasion, lifestyle and the cloth that suits both. Over three hundred bunches from the finest mills.",
          "ar": "نناقش المناسبة وأسلوب حياتك والقماش الذي يناسبهما، من أكثر من ثلاثمئة عيّنة من أرقى المصانع."
        }
      },
      {
        "title": {
          "en": "Measurement",
          "ar": "القياس"
        },
        "text": {
          "en": "Every slope of the shoulder, every turn of the stance recorded and drafted into a personal paper pattern.",
          "ar": "كل ميل في الكتف وكل انحناءة في الوقفة تُسجَّل وتتحول إلى نمط ورقي خاص بك."
        }
      },
      {
        "title": {
          "en": "Fittings",
          "ar": "البروفات"
        },
        "text": {
          "en": "A basted fitting, a forward fitting, a finished fitting. The garment learns your body in stages.",
          "ar": "بروفة أولية، وأخرى متقدمة، وأخيرة نهائية. القطعة تتعلم جسدك على مراحل."
        }
      },
      {
        "title": {
          "en": "Delivery",
          "ar": "التسليم"
        },
        "text": {
          "en": "Pressed by hand, presented in our garment carrier, and kept on file for every commission after.",
          "ar": "تُكوى يدوياً، وتُقدَّم في حقيبة ملابسنا، وتُحفظ في سجلّك لكل طلب لاحق."
        }
      }
    ]
